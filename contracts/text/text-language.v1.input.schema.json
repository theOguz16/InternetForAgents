{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "text"
  ],
  "properties": {
    "profile": {
      "const": "text-language.v1"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    }
  }
}
