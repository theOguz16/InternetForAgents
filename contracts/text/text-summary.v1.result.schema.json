{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "output"
  ],
  "properties": {
    "profile": {
      "const": "text-summary.v1"
    },
    "mode": {
      "enum": [
        "fixture",
        "deterministic",
        "model"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
