{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "output"
  ],
  "properties": {
    "profile": {
      "const": "text-keywords.v1"
    },
    "mode": {
      "enum": [
        "fixture",
        "deterministic",
        "model"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
