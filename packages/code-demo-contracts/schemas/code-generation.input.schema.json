{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "properties": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "functionName",
        "parameters",
        "returnType",
        "requirements"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "const": "python"
        },
        "functionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "parameters": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 9,
                "enum": [
                  "int",
                  "bool",
                  "str",
                  "list[int]",
                  "list[str]"
                ]
              }
            }
          }
        },
        "returnType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9,
          "enum": [
            "int",
            "bool",
            "str",
            "list[int]",
            "list[str]"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
