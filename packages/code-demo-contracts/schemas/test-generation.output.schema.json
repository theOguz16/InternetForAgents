{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "tests",
    "scenarios"
  ],
  "properties": {
    "framework": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "const": "unittest"
    },
    "tests": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
