{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ifa-result.v1 envelope",
  "$comment": "Güvenilir platform şemasıdır. input/output ayrıca seçilen manifest şemasıyla; kimlik, sürüm, invocation ve mode çalışma bağlamıyla doğrulanır. A2A taşıma zarfını kapsamaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "capability",
    "invocationId",
    "output",
    "mode"
  ],
  "properties": {
    "contract": {
      "const": "ifa-result.v1"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
        }
      }
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "output": {
      "type": "object"
    },
    "mode": {
      "enum": [
        "fixture",
        "deterministic",
        "model"
      ]
    }
  }
}
