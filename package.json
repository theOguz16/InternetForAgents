{
  "name": "internet-for-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Local agent discovery and collaboration platform",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "train": "node train-planner.js",
    "dev:service": "tsx services/main.ts",
    "build:services": "tsc -p tsconfig.services.json",
    "start:service": "node dist/services/main.js",
    "export:contracts": "npm run build:services && node scripts/export-contracts.cjs",
    "test:services": "npm run build:services && node --test tests/*.test.cjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.mjs",
    "build": "npm run build:services && npm run build:web",
    "validate:manifest": "npm run build:services && node scripts/validate-manifest.cjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "ajv": "8.17.1",
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
